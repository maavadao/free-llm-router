# Copy to .env for local runs (node --env-file=.env src/server.ts). On Cloud Run these come from Secret Manager.

# Bearer tokens the router accepts, comma-separated (the website holds one). Required unless ROUTER_DEV=1.
ROUTER_TOKENS=
# ROUTER_DEV=1

# Provider keys: a provider is used only when its key is set. Each is a free-tier key for maavaDao's own account.
GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Gemini is off in config/providers.json (see the note there) even with a key.
GEMINI_API_KEY=

# Optional
# ROUTER_NO_TRAINING=1          # skip providers whose free tier may train on prompts
# ROUTER_MAX_TOKENS=4096        # cap on any reply
# ROUTER_USER_RPM=10            # per member, by X-Router-User
# ROUTER_USER_RPD=200
# ROUTER_UPSTREAM_TIMEOUT_MS=30000
# ROUTER_CONFIG=/path/to/providers.json
