{
  "$comment": "Free-tier providers and the models maava AI offers. Free tiers change often: check each provider's limits and terms before relying on them. Providers with a keyEnv are used only when that key is set; keyless providers (OVHcloud, Kilo Code, LLM7) work out of the box, so the router answers with no keys at all. Keyless limits are per IP, so every member shares them. Limits are per key; the router keeps under them and fails over when a provider says no. dataUse: 'no-training' (the provider says prompts aren't used for training), 'may-train' (free-tier prompts may be used to train or improve models), or 'unknown'. Checked 2026-11-09 against https://github.com/mnfst/awesome-free-llm-apis.",
  "providers": {
    "groq": {
      "name": "Groq",
      "baseUrl": "https://api.groq.com/openai/v1",
      "keyEnv": "GROQ_API_KEY",
      "dataUse": "unknown",
      "models": {
        "openai/gpt-oss-120b": {
          "context": 131072,
          "rpm": 30,
          "rpd": 1000
        },
        "openai/gpt-oss-20b": {
          "context": 131072,
          "rpm": 30,
          "rpd": 1000
        },
        "qwen/qwen3.8-27b": {
          "context": 131072,
          "rpm": 30,
          "rpd": 1000
        }
      }
    },
    "cerebras": {
      "name": "Cerebras",
      "baseUrl": "https://api.cerebras.ai/v1",
      "keyEnv": "CEREBRAS_API_KEY",
      "dataUse": "unknown",
      "models": {
        "gpt-oss-120b": {
          "context": 8192,
          "rpm": 30,
          "rpd": 14400
        },
        "qwen-3-235b-a22b-instruct-2507": {
          "context": 8192,
          "rpm": 30,
          "rpd": 14400
        }
      }
    },
    "nvidia": {
      "name": "NVIDIA NIM",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "keyEnv": "NVIDIA_API_KEY",
      "dataUse": "may-train",
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "context": 1000000,
          "rpm": 40,
          "rpd": 10000
        },
        "google/gemma-4-31b-it": {
          "context": 262144,
          "rpm": 40,
          "rpd": 10000
        },
        "openai/gpt-oss-20b": {
          "context": 131072,
          "rpm": 40,
          "rpd": 10000
        }
      }
    },
    "mistral": {
      "name": "Mistral",
      "baseUrl": "https://api.mistral.ai/v1",
      "keyEnv": "MISTRAL_API_KEY",
      "dataUse": "may-train",
      "models": {
        "mistral-medium-latest": {
          "context": 262144,
          "rpm": 60
        },
        "mistral-small-latest": {
          "context": 262144,
          "rpm": 60
        }
      }
    },
    "openrouter": {
      "name": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "keyEnv": "OPENROUTER_API_KEY",
      "dataUse": "may-train",
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "context": 1000000,
          "rpm": 20,
          "rpd": 50,
          "pool": "free"
        },
        "nvidia/nemotron-3.5-lightning:free": {
          "context": 1000000,
          "rpm": 20,
          "rpd": 50,
          "pool": "free"
        }
      },
      "$comment": "OpenRouter's 20 RPM and 50 RPD are shared across all :free models, hence the shared pool."
    },
    "gemini": {
      "name": "Google Gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "keyEnv": "GEMINI_API_KEY",
      "dataUse": "may-train",
      "enabled": false,
      "$comment": "Off by default: Google's terms require Paid Services when an app is offered to users in the EEA, Switzerland or the UK. Turn on only with a paid key or for a deployment that serves no one there.",
      "models": {
        "gemini-2.5-flash": {
          "context": 1000000,
          "rpm": 10
        }
      }
    },
    "ovh": {
      "name": "OVHcloud AI Endpoints",
      "baseUrl": "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1",
      "dataUse": "unknown",
      "$comment": "Keyless anonymous tier: 2 requests a minute per IP, per model. Hosted in the EU.",
      "models": {
        "gpt-oss-120b": {
          "context": 131072,
          "rpm": 2
        },
        "Qwen3.5-397B-A17B": {
          "context": 262144,
          "rpm": 2
        },
        "Meta-Llama-3_3-70B-Instruct": {
          "context": 131072,
          "rpm": 2
        },
        "Qwen3.8-27B": {
          "context": 262144,
          "rpm": 2
        },
        "Mistral-Small-3.2-24B-Instruct-2506": {
          "context": 131072,
          "rpm": 2
        },
        "gpt-oss-20b": {
          "context": 131072,
          "rpm": 2
        }
      }
    },
    "kilo": {
      "name": "Kilo Code",
      "baseUrl": "https://api.kilo.ai/api/gateway",
      "dataUse": "may-train",
      "$comment": "Keyless free pool: 200 requests an hour per IP, shared by every :free model (hence the pool and 3 a minute). Kilo says the free pool may route to providers that log prompts, and NVIDIA's free endpoints log use to improve NVIDIA products.",
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "context": 1000000,
          "rpm": 3,
          "pool": "free"
        },
        "nvidia/nemotron-3.5-lightning:free": {
          "context": 1000000,
          "rpm": 3,
          "pool": "free"
        },
        "kilo-auto/free": {
          "context": 262144,
          "rpm": 3,
          "pool": "free"
        }
      }
    },
    "llm7": {
      "name": "LLM7.io",
      "baseUrl": "https://api.llm7.io/v1",
      "dataUse": "unknown",
      "$comment": "Keyless anonymous access to the 'turbo' models. Limits for anonymous use aren't published (a free token gets 60 a minute and 250 an hour), so the router stays well under.",
      "models": {
        "gpt-oss:20b": {
          "context": 131072,
          "rpm": 4
        },
        "llama-4-maverick": {
          "context": 131072,
          "rpm": 4
        },
        "mistral-Small-24B-Instruct-2501": {
          "context": 32768,
          "rpm": 4
        }
      }
    }
  },
  "aliases": {
    "auto": {
      "label": "Auto",
      "description": "The best free model that's available right now.",
      "routes": [
